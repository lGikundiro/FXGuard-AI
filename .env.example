# Supabase project settings (never commit real secret values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Enable only providers already configured in Supabase Auth.
AUTH_METHODS=email

# Uses migration 002 so signed-in users can delete only their own account.
AUTH_SELF_DELETE_RPC=true

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://app.example.com

# Use true only over HTTPS. Local development defaults to false.
AUTH_COOKIE_SECURE=false

# Native feedback form. The default URL is the project's existing Google Form
# response destination; override it only when connecting another form.
GOOGLE_FORM_RESPONSE_URL=https://docs.google.com/forms/d/e/1FAIpQLSd3E97VFGFl7v-9ojSAAmPc4RkE-30tf9YCJ_XUhPuw8JFbBg/formResponse
